FROM python:3.11-slim

WORKDIR /app

COPY api/requirements.txt ./requirements.txt
# The last three are for ingestion.fast_refresh, which only runs in this image.
# They stay out of api/requirements.txt because that file also feeds the Lambda build.
RUN pip install --no-cache-dir -r requirements.txt \
    psycopg2-binary==2.9.9 requests==2.32.3 python-dotenv==1.0.1

COPY api/ ./api/
COPY ingestion/ ./ingestion/
COPY spark_jobs/ ./spark_jobs/
COPY database/ ./database/
RUN mkdir -p /app/data/raw

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
